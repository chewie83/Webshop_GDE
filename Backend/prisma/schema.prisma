// SQLite használatának beállítása 
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}
// Kategória tábla létrehozása

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique 
  products Product[]
}

// Termék tábla létrehozása 

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  image       String?
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
}